# Copy to .env.local and fill in. Only the first block is needed to boot.

# --- Required ---
NEXT_PUBLIC_SUPABASE_URL=            # https://<project-ref>.supabase.co
SUPABASE_MANAGEMENT_TOKEN=           # Supabase Management API token; most queries run through this
SUPABASE_SERVICE_ROLE_KEY=           # Supabase secret key (sponsors, analytics, uploads)
DASHBOARD_KEY=                       # Admin access key; unset = admin pages deny everything
NEXT_PUBLIC_SITE_URL=http://localhost:3004

# --- Tournament engine ---
CRON_SECRET=                         # Shared secret pg_cron sends when calling /api/tournament/advance
INTERNAL_API_SECRET=                 # Auth for internal route-to-route calls

# --- Email (AWS SES primary, Resend fallback) ---
FROM_EMAIL=                          # Verified sender address
ADMIN_EMAIL=                         # Receives admin-review flags (e.g. disputed scores)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=               # Verifies inbound email webhooks
EMAIL_TEST_REDIRECT=                 # If set, every outgoing email goes here instead (dev safety)
TEST_EMAIL=                          # Recipient for scripts/*-review.ts and *-test.ts

# --- Optional integrations ---
TURNSTILE_SECRET_KEY=                # Cloudflare Turnstile (signup bot protection)
META_ACCESS_TOKEN=                   # Meta Graph API (ad + Instagram stats on dashboard)
META_AD_ACCOUNT_ID=
META_INSTAGRAM_ID=
GA4_PROPERTY_ID=                     # Google Analytics 4 Data API (dashboard)
GA4_CLIENT_ID=
GA4_CLIENT_SECRET=
GA4_REFRESH_TOKEN=
